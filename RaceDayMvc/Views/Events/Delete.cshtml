@model EventDetailViewModel
@{
    ViewData["Title"] = "Delete Event";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Events" asp-action="MyEvents">My Events</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm mx-auto" style="max-width: 640px;">
    <div class="card-body p-4">
        <div class="text-center mb-3">
            <i class="bi bi-exclamation-triangle-fill text-danger display-5"></i>
        </div>
        <h1 class="rd-section-title h4 text-center">Delete this event?</h1>
        <p class="text-center text-muted">
            <strong>@Model.EventName</strong> on @Model.EventDate.ToString("dd MMM yyyy")<br />
            @Model.Location &middot; @Model.EnrolmentCount participants entered
        </p>
        <div class="alert alert-warning">
            This is a <strong>soft delete</strong>: the event disappears from RaceDay immediately, but
            existing enrolments and results stay safely stored in the database.
        </div>
        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.EventId" />
            <div class="d-flex gap-2 justify-content-center">
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i>Yes, delete it
                </button>
                <a class="btn btn-outline-secondary" asp-controller="Events" asp-action="MyEvents">Cancel</a>
            </div>
        </form>
    </div>
</div>
