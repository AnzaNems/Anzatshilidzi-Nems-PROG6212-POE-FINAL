@model SaveEventViewModel
@{
    ViewData["Title"] = "Create Event";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Events" asp-action="MyEvents">My Events</a></li>
        <li class="breadcrumb-item active" aria-current="page">Create</li>
    </ol>
</nav>

<h1 class="rd-section-title"><i class="bi bi-plus-circle rd-accent-text me-2"></i>Create a new event</h1>
<p class="text-muted">All fields are required except the banner image.</p>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control" placeholder="e.g. Soweto Marathon 2027" />
                    <span asp-validation-for="EventName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventTypeId" class="form-label"></label>
                    <select asp-for="EventTypeId" class="form-select">
                        <option value="1">Run</option>
                        <option value="2">Walk</option>
                        <option value="3">Cycle</option>
                    </select>
                    <span asp-validation-for="EventTypeId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" class="form-control" type="date"
                           value="@Model.EventDate.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="EventDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DistanceKm" class="form-label"></label>
                    <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" min="0.1" />
                    <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Durban Beachfront" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="Tell participants what makes this event special..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BannerImage" class="form-label"></label>
                    <input asp-for="BannerImage" class="form-control" type="file" accept="image/*" />
                    <div class="form-text">JPG or PNG, max 5 MB. Stored in Azure Blob Storage.</div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn rd-btn-accent px-4">
                    <i class="bi bi-check2-circle me-1"></i>Create event
                </button>
                <a class="btn btn-outline-secondary" asp-controller="Events" asp-action="MyEvents">Cancel</a>
            </div>
        </form>
    </div>
</div>
