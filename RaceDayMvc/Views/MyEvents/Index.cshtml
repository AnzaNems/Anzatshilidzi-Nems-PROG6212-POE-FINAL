@model List<EnrolmentViewModel>
@{
    ViewData["Title"] = "My Events";
    var today = DateTime.Today;
}

<h1 class="rd-section-title mb-1"><i class="bi bi-journal-check rd-accent-text me-2"></i>My events</h1>
<p class="text-muted">Every event you have entered, with your current enrolment status.</p>

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <i class="bi bi-rocket-takeoff display-6 d-block mb-2"></i>
        You have not entered any events yet.
        <div class="mt-2">
            <a class="btn rd-btn-accent" asp-controller="Home" asp-action="Index">Browse upcoming events</a>
        </div>
    </div>
}
else
{
    var upcoming = Model.Where(e => e.EventDate.Date >= today).ToList();
    var past = Model.Where(e => e.EventDate.Date < today).ToList();

    if (upcoming.Count > 0)
    {
        <h2 class="rd-section-title h5"><i class="bi bi-calendar-event me-1"></i>Upcoming (@upcoming.Count)</h2>
        <div class="row g-3 mb-4">
            @foreach (var e in upcoming)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="rd-card-title mb-1">@e.EventName</h5>
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-calendar3 me-1"></i>@e.EventDate.ToString("ddd, dd MMM yyyy")
                                        &middot; <i class="bi bi-geo-alt-fill me-1"></i>@e.Location
                                    </p>
                                    <p class="mb-0 small">
                                        Category: <strong>@e.CategoryName</strong>
                                    </p>
                                </div>
                                @if (e.Status == "Confirmed")
                                {
                                    <span class="badge-status badge-status-confirmed"><i class="bi bi-check2 me-1"></i>Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status-pending"><i class="bi bi-hourglass me-1"></i>Pending</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 pb-3">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">View event</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    if (past.Count > 0)
    {
        <h2 class="rd-section-title h5"><i class="bi bi-clock-history me-1"></i>Completed (@past.Count)</h2>
        <div class="table-responsive bg-white rounded-3 border">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in past)
                    {
                        <tr>
                            <td><strong>@e.EventName</strong></td>
                            <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@e.CategoryName</td>
                            <td>
                                @if (e.Status == "Confirmed")
                                {
                                    <span class="badge-status badge-status-confirmed">Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status-pending">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-2">
            <a class="btn btn-outline-primary btn-sm" asp-controller="MyResults" asp-action="Index">
                <i class="bi bi-stopwatch me-1"></i>See my results
            </a>
        </div>
    }
}
