@model List<EnrolmentViewModel>
@{
    ViewData["Title"] = "Enrolments";
    var evt = (EventDetailViewModel)ViewBag.Event;
    var confirmed = Model.Count(e => e.Status == "Confirmed");
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Events" asp-action="MyEvents">My Events</a></li>
        <li class="breadcrumb-item active" aria-current="page">Enrolments</li>
    </ol>
</nav>

<h1 class="rd-section-title mb-1"><i class="bi bi-people rd-accent-text me-2"></i>Enrolments</h1>
<p class="text-muted">
    Everyone who entered <strong>@evt.EventName</strong>
    (@evt.EventDate.ToString("dd MMM yyyy")) - @Model.Count total,
    <span class="badge-status badge-status-confirmed">@confirmed confirmed</span>
</p>

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <i class="bi bi-people display-6 d-block mb-2"></i>
        No participants have entered this event yet.
    </div>
}
else
{
    <div class="table-responsive bg-white rounded-3 border">
        <table class="table table-hover rd-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Entered on</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><strong>@e.ParticipantName</strong></td>
                        <td>@e.CategoryName</td>
                        <td>
                            @if (e.Status == "Confirmed")
                            {
                                <span class="badge-status badge-status-confirmed"><i class="bi bi-check2 me-1"></i>Confirmed</span>
                            }
                            else
                            {
                                <span class="badge-status badge-status-pending"><i class="bi bi-hourglass me-1"></i>Pending</span>
                            }
                        </td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            @if (e.Status != "Confirmed")
                            {
                                <form asp-controller="Enrolments" asp-action="Confirm" method="post" class="d-inline">
                                    <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                    <input type="hidden" name="eventId" value="@e.EventId" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-check2-all me-1"></i>Confirm
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3 d-flex gap-2">
    <a class="btn btn-outline-primary btn-sm" asp-controller="Results" asp-action="Entry" asp-route-eventId="@evt.EventId">
        <i class="bi bi-stopwatch me-1"></i>Go to results entry
    </a>
</div>
