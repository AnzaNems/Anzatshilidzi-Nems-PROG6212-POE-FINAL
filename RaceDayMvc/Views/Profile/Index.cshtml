@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<h1 class="rd-section-title mb-1"><i class="bi bi-person-circle rd-accent-text me-2"></i>My profile</h1>
<p class="text-muted">View and update your personal information.</p>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" alt="Profile picture"
                         class="rounded-circle mb-3" style="width: 140px; height: 140px; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 rd-stat-navy"
                         style="width: 140px; height: 140px; font-size: 3rem;">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                }
                <h5 class="mb-0 fw-bold">@Model.FullName</h5>
                <p class="text-muted">@Model.Email</p>
                <span class="badge-type @(Model.Role == "Organiser" ? "badge-type-3" : "badge-type-2")">@Model.Role</span>
                <p class="text-muted small mt-3 mb-0">
                    <i class="bi bi-calendar-check me-1"></i>Member since @Model.CreatedAt.ToString("MMMM yyyy")
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Index" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Role" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="ProfilePictureUrl" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Picture" class="form-label"></label>
                            <input asp-for="Picture" class="form-control" type="file" accept="image/*" />
                            <div class="form-text">
                                JPG or PNG, max 5 MB. Stored in Azure Blob Storage via the API.
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn rd-btn-accent px-4 mt-4">
                        <i class="bi bi-check2-circle me-1"></i>Save profile
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
