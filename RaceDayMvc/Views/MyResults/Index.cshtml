@model List<ResultViewModel>
@{
    ViewData["Title"] = "My Results";
}

<h1 class="rd-section-title mb-1"><i class="bi bi-stopwatch rd-accent-text me-2"></i>My results</h1>
<p class="text-muted">
    Your personal race history - every finish time and position captured by the organisers.
</p>

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <i class="bi bi-stopwatch display-6 d-block mb-2"></i>
        No results yet. Once you finish a race and the organiser captures the results,
        they will appear here.
        <div class="mt-2">
            <a class="btn rd-btn-accent" asp-controller="Home" asp-action="Index">Find your next race</a>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="rd-stat rd-stat-navy h-100">
                <div class="rd-stat-value">@Model.Count</div>
                <div class="rd-stat-label"><i class="bi bi-patch-check me-1"></i>Races completed</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-stat rd-stat-orange h-100">
                <div class="rd-stat-value">@Model.Where(r => !r.IsDisqualified).Select(r => r.FinishTime).OrderBy(t => t).FirstOrDefault() ?? "-:--:--"</div>
                <div class="rd-stat-label"><i class="bi bi-lightning-charge-fill me-1"></i>Personal best</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-stat rd-stat-teal h-100">
                <div class="rd-stat-value">@Model.Count(r => r.Position == 1 && !r.IsDisqualified)</div>
                <div class="rd-stat-label"><i class="bi bi-trophy me-1"></i>Category wins</div>
            </div>
        </div>
    </div>

    <div class="table-responsive bg-white rounded-3 border">
        <table class="table table-hover rd-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="@(r.IsDisqualified ? "table-warning" : "")">
                        <td>
                            <strong>@r.EventName</strong><br />
                            <small class="text-muted"><i class="bi bi-geo-alt-fill"></i> Event #@r.EventId</small>
                        </td>
                        <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@r.CategoryName</td>
                        <td>
                            @if (r.IsDisqualified)
                            {
                                <span class="text-decoration-line-through text-muted">@r.FinishTime</span>
                                <span class="badge bg-danger ms-1">DQ</span>
                            }
                            else
                            {
                                <strong>@r.FinishTime</strong>
                            }
                        </td>
                        <td>
                            @if (r.IsDisqualified)
                            {
                                <span class="text-muted">-</span>
                            }
                            else
                            {
                                <span>
                                    <strong>@FormatHelpers.Ordinal(r.Position)</strong>
                                    <span class="text-muted small">out of @r.TotalFinishers finisher@(r.TotalFinishers == 1 ? "" : "s")</span>
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
