@model ErrorViewModel
<div class="rd-hero-compact rounded-3 p-5 text-center">
    <i class="bi bi-exclamation-octagon display-4 rd-accent"></i>
    <h1 class="mt-2">Something went wrong</h1>
    <p class="mb-0">
        The page could not be loaded. This usually means the RaceDay API is not running -
        start <strong>RaceDayApi</strong> in Visual Studio, then come back and try again.
    </p>
</div>
<div class="text-center mt-3">
    <a class="btn rd-btn-accent" asp-controller="Home" asp-action="Index">Back to events</a>
</div>
