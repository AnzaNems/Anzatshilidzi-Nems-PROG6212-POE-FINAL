@{
    var token = Context.Session.GetString("Token");
    var role = Context.Session.GetString("Role");
    var fullName = Context.Session.GetString("FullName");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/raceday.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand rd-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-flag-fill rd-brand-icon"></i> RaceDay
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-calendar-event me-1"></i>Events</a>
                    </li>
                    @if (role == "Organiser")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="MyEvents"><i class="bi bi-trophy me-1"></i>My Events</a></li>
                    }
                    else if (role == "Participant")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="MyEvents" asp-action="Index"><i class="bi bi-journal-check me-1"></i>My Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="MyResults" asp-action="Index"><i class="bi bi-stopwatch me-1"></i>My Results</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (token != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person-circle me-1"></i>@fullName
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm rd-logout-btn">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn rd-btn-accent btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="rd-main">
        <div class="container py-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (ViewBag.ApiError != null)
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-plug me-1"></i>@ViewBag.ApiError
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="rd-footer mt-auto">
        <div class="container text-center py-3">
            <span class="fw-semibold">RaceDay</span> &mdash; event management for the South African
            running, walking and cycling community<br />
            <small>PROG6212 Portfolio of Evidence &middot; Anzatshilidzi Nemafukani &middot; ST10480934</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
