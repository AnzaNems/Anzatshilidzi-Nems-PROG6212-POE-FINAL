@model List<EnrolmentViewModel>
@{
    ViewData["Title"] = "My Dashboard";
    var next = (EnrolmentViewModel?)ViewBag.NextEvent;
}

<h1 class="rd-section-title mb-1">Your RaceDay</h1>
<p class="text-muted">Everything you have entered, at a glance.</p>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="rd-stat rd-stat-navy h-100">
            <div class="rd-stat-value">@ViewBag.TotalEnrolments</div>
            <div class="rd-stat-label"><i class="bi bi-journal-check me-1"></i>Events entered</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="rd-stat rd-stat-teal h-100">
            <div class="rd-stat-value">@ViewBag.ConfirmedCount</div>
            <div class="rd-stat-label"><i class="bi bi-patch-check-fill me-1"></i>Confirmed entries</div>
        </div>
    </div>
</div>

@if (next != null)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-emoji-trophy me-2"></i>
            Next race: <strong>@next.EventName</strong> on @next.EventDate.ToString("dd MMMM yyyy")
            in @next.Location (@next.CategoryName)
        </div>
        <a class="btn btn-sm btn-outline-primary"
           asp-controller="Events" asp-action="Details" asp-route-id="@next.EventId">Details</a>
    </div>
}
else
{
    <div class="rd-empty mb-4">
        <i class="bi bi-rocket-takeoff display-6 d-block mb-2"></i>
        You have not entered an upcoming event yet.
        <div class="mt-2">
            <a class="btn rd-btn-accent" asp-controller="Home" asp-action="Index">Browse events</a>
        </div>
    </div>
}

<div class="d-flex gap-2 flex-wrap">
    <a class="btn rd-btn-accent" asp-controller="Home" asp-action="Index">
        <i class="bi bi-search me-1"></i>Browse events
    </a>
    <a class="btn btn-outline-primary" asp-controller="MyEvents" asp-action="Index">
        <i class="bi bi-journal-check me-1"></i>My events
    </a>
    <a class="btn btn-outline-primary" asp-controller="MyResults" asp-action="Index">
        <i class="bi bi-stopwatch me-1"></i>My results
    </a>
</div>
